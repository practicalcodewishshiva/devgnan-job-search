# Business stack — global settings. Copy to stack.env and edit, then run ./stack.sh init
# (./stack.sh init creates stack.env from this file automatically if it is missing.)

# Hostname or IP people use to reach the server, and http/https.
# Leave as localhost when testing on your own laptop.
PUBLIC_HOST=localhost
PUBLIC_SCHEME=http

# 127.0.0.1 = only reachable from this machine (use an SSH tunnel or a reverse proxy).
# 0.0.0.0   = reachable from the network. Only do this behind a firewall / HTTPS proxy.
BIND_IP=127.0.0.1

TZ=Asia/Kolkata

# Admin account used where an app creates one on first boot (Invoice Ninja).
ADMIN_EMAIL=admin@example.com

# Outgoing email (optional but needed for invites, password resets, signing requests,
# invoices). Any SMTP provider works: Gmail app password, Brevo, Resend, SES, Zoho...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="My Business"

# Host ports, one per app.
N8N_PORT=5678
TWENTY_PORT=3001
CALCOM_PORT=3002
DOCUMENSO_PORT=3003
CHATWOOT_PORT=3004
POSTIZ_PORT=4007
INVOICENINJA_PORT=8081
PLANE_PORT=8082

# Optional: set the public URL of an app explicitly when it sits behind a reverse proxy
# on its own (sub)domain, e.g. N8N_URL=https://n8n.example.com
# Otherwise it defaults to PUBLIC_SCHEME://PUBLIC_HOST:<PORT>.
#N8N_URL=
#TWENTY_URL=
#CALCOM_URL=
#DOCUMENSO_URL=
#CHATWOOT_URL=
#POSTIZ_URL=
#INVOICENINJA_URL=
#PLANE_URL=
